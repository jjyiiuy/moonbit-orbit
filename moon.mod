name = "jjyiiuy/moonbit-orbit"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/jjyiiuy/moonbit-orbit"

license = "Apache-2.0"

keywords = [ "orbital-mechanics", "aerospace", "mission-analysis", "moonbit" ]

preferred_target = "wasm-gc"

description = "A MoonBit orbital mechanics and spacecraft mission computation library."
